# Copy to .env.local for local development.

# AI coach. Uses an OpenAI-compatible Chat Completions endpoint.
# Alibaba Cloud Model Studio / Bailian example model: qwen3.7-plus
COACH_PROVIDER=aliyun-bailian
COACH_API_KEY=
COACH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COACH_MODEL=qwen3.7-plus
COACH_ENABLE_THINKING=false
# Optional. Screenshot recognition on the analysis page. Same API key as the coach.
# qwen3.7-plus is not a vision model; leave this as a VL model.
ANALYSIS_VISION_MODEL=qwen-vl-plus

# Persistence. Railway provides these in production; set them locally only if
# you want local identity/history/match persistence to use the same services.
DATABASE_URL=
REDIS_URL=
# Set to "disable" only for a local Postgres instance that does not use TLS.
PGSSL=

# Registered account recovery via Clerk.
# Publishable key is safe to expose to the browser; secret key must stay server-side.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated origins allowed to mint accepted Clerk session tokens.
# Example: http://localhost:5173,https://qili-xiangqi-production.up.railway.app
CLERK_AUTHORIZED_PARTIES=
